<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppThemeBase" parent="android:style/Theme.Material.NoActionBar">
        <item name="android:fontFamily">sans</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:statusBarColor">#101416</item>
        <item name="android:navigationBarColor">#101416</item>
        <item name="android:windowActionModeOverlay">true</item>
        <item name="android:colorAccent">#60E0C0</item>
        <item name="android:windowBackground">#101416</item>
        <item name="android:alertDialogTheme">@style/DialogTheme</item>
    </style>
    <style name="AppTheme" parent="AppThemeBase" />
    <style name="DialogTheme" parent="android:style/Theme.Material.Dialog.Alert">
        <item name="android:colorAccent">#60E0C0</item>
        <item name="android:colorBackgroundFloating">#1A2023</item>
        <item name="android:windowBackground">@drawable/dialog_background</item>
    </style>
    <style name="PlayerTheme" parent="AppTheme">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowBackground">#000000</item>
        <item name="android:navigationBarColor">#000000</item>
        <item name="android:statusBarColor">#000000</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
